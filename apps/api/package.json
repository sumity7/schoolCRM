{
  "name": "@edunex/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "cli": "tsx --env-file-if-exists=.env scripts/cli.ts"
  },
  "dependencies": {
    "@edunex/shared": "*",
    "argon2": "^0.41.1",
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.0",
    "pino": "^9.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.0.0",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
