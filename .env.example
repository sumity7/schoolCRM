# EduNex ERP — example environment. Copy to apps/api/.env (git-ignored). Never commit real values.
# ---- API (apps/api) ----
NODE_ENV=development
APP_ENV_LABEL=DEV
PORT=4000
# Local replica set started by `npm run dev:db` (transactions need a replica set)
DATABASE_URL=mongodb://127.0.0.1:27017/edunex_dev?replicaSet=rs0
# Origins allowed for state-changing requests (CSRF Origin check). Comma separated.
ALLOWED_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Number of trusted reverse-proxy hops in front of Express (0 locally; 1 behind Caddy/nginx)
TRUST_PROXY_HOPS=0
# MUST be true in production (enables __Host- cookie prefix and Secure flag)
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_DAYS=14
SESSION_REMEMBER_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info
# dev-outbox writes emails to apps/api/.data/mail instead of sending (no provider configured, D-28)
EMAIL_ADAPTER=console
# Paid / unauthorised integrations — MUST stay false until explicitly approved (D-28, D-11)
FEATURE_ONLINE_PAYMENTS=false
FEATURE_SMS=false
FEATURE_WHATSAPP=false
~
# ---- Web (apps/web) ----
# Express base URL the Next.js server proxies /api/* to (dev/staging rewrites; production uses a reverse proxy)
API_ORIGIN=http://127.0.0.1:4000

# ---- Development-only login-page demo accounts ----
# Default: on only when NODE_ENV=development. The API refuses to start if this is true in production/staging.
# DEMO_LOGIN_ENABLED=false
