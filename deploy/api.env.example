# /etc/edunex/api.env  (chmod 600, owner root:edunex). Values below are EXAMPLES — every one must be set for your host.
NODE_ENV=production
APP_ENV_LABEL=
HOST=127.0.0.1
PORT=4000
# Managed MongoDB replica set with backups (doc 12 §4). Localhost is refused in production.
DATABASE_URL=mongodb+srv://edunex:CHANGE_ME@cluster.example.mongodb.net/edunex?retryWrites=true&w=majority
APP_BASE_URL=https://app.example.in
ALLOWED_ORIGINS=https://app.example.in
TRUST_PROXY_HOPS=1
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_DAYS=14
SESSION_REMEMBER_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# No email provider is authorised yet (D-28): 'console' writes to the server log/outbox only.
EMAIL_ADAPTER=console
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true
# Must stay false until explicitly approved (enforced at startup).
FEATURE_ONLINE_PAYMENTS=false
FEATURE_SMS=false
FEATURE_WHATSAPP=false
MFA_ENCRYPTION_KEY=generate-with-openssl-rand-base64-48
